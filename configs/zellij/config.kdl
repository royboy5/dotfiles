// =============================================================================
// ZELLIJ CONFIG
// Docs: https://zellij.dev/documentation/
// Anything not set here falls back to Zellij's built-in defaults, so this file
// stays small on purpose. Dump the full default config with:
//   zellij setup --dump-config
// =============================================================================

// ---------- APPEARANCE ----------

// Built-in theme, matches the tmux tokyo-night (storm) setup.
theme "tokyo-night-storm"

// Draw a full border around every pane. Without this, `pane_frame_style`
// defaults to "titles", which only draws a title line above each pane —
// no amount of removing `borderless` from a layout will add borders.
pane_frames true
pane_frame_style "full"

ui {
    pane_frames {
        rounded_corners true
    }
}

// Set to "compact" for a slimmer status bar with no top tab bar.
default_layout "default"

// Hide the "tips" banner on new sessions.
show_startup_tips false

// ---------- BEHAVIOUR ----------

default_shell "zsh"

// Start unlocked so keybinds work right away (Ctrl-g toggles lock mode).
default_mode "normal"

mouse_mode true

// Copy goes to the system clipboard through the terminal (OSC 52), so no
// copy_command is needed on any host, WSL included.
copy_on_select true

// Ask instead of silently killing panes on Ctrl-c / SIGTERM of the terminal.
on_force_close "detach"

// Keep session layouts/scrollback across reboots so `zellij attach` resumes.
session_serialization true

// ---------- KEYBINDS ----------
// Defaults are kept; only the conflicts below are adjusted.

keybinds {
    // Ctrl-q is far too easy to fat-finger and it kills the whole session.
    unbind "Ctrl q"

    session {
        // Quit is still reachable, but deliberately: Ctrl-o then q.
        bind "q" { Quit; }
    }

    tab {
        // New tab pre-populated with the dev layout: Ctrl-t then d.
        // "dev" resolves to dev.kdl in the layout dir (~/.config/zellij/layouts).
        bind "d" { NewTab { layout "dev"; }; SwitchToMode "normal"; }
    }

    shared_except "locked" {
        // Same thing in one shot, without entering tab mode first.
        bind "Alt d" { NewTab { layout "dev"; }; }

        // Ctrl-h/j/k/l move between zellij panes AND nvim splits. The plugin
        // passes the key to nvim when nvim is focused (smart-splits.nvim on the
        // nvim side). Focus stops at the edge; tabs are Ctrl-Shift-h/l.
        // These replace the default Ctrl-h (Move mode), so Move mode has no key.
        // move_mod goes on every bind: the plugin reads its config from the
        // first message it gets.
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "left";
                move_mod "ctrl";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "right";
                move_mod "ctrl";
            };
        }
    }

    normal {
        // Tab Navigation
        bind "Ctrl Shift h" { GoToPreviousTab; }
        bind "Ctrl Shift l" { GoToNextTab; }
    }
}
