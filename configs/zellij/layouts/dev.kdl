// Dev layout: editor over shell on the left, AI pane full height on the right.
// Usage: zellij --layout dev
layout {
    pane size=1 {
        plugin location="zellij:tab-bar"
        borderless true
    }
    pane split_direction="vertical" {
        // Left column, stacked: editor on top, shell underneath.
        pane size="65%" split_direction="horizontal" {
            pane size="70%" {
                name "editor"
            }
            pane size="30%" {
                name "shell"
            }
        }
        // Right column, full height.
        pane {
            name "llm"
        }
    }
    pane size=1 {
        plugin location="zellij:status-bar"
        borderless true
    }
}
